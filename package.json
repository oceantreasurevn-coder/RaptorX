{
  "name": "raptorx-site",
  "version": "1.0.0",
  "private": true,
  "description": "RAPTOR[X] static site + chat API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/tailwind.css --minify",
    "build:js": "babel src/app.jsx --out-file assets/app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "engines": {
    "node": "18.x"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.8",
    "@babel/core": "^7.24.8",
    "@babel/preset-env": "^7.24.8",
    "@babel/preset-react": "^7.24.7",
    "tailwindcss": "^3.4.10"
  }
}
